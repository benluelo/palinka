##########
# Hasher #
##########

# An incremental hasher that can accept any number of writes.
#
# pub struct Hasher {
#     chunk_state: ChunkState,
#     key_words: [u32; 8],
#     cv_stack: [[u32; 8]; 54], // Space for 54 subtree chaining values:
#     cv_stack_len: u8,         // 2^54 * CHUNK_LEN = 2^64
#     flags: u32,
# }

def HASHER__KEY_WORDS__OFFSET()    -> x { x <- CHUNK_STATE__SIZE()                                     }
def HASHER__CV_STACK__OFFSET()     -> x { x <- add(mul(4, 8),          HASHER__KEY_WORDS__OFFSET())    }
def HASHER__CV_STACK_LEN__OFFSET() -> x { x <- add(mul(mul(4, 8), 54), HASHER__CV_STACK__OFFSET())     }
def HASHER__FLAGS__OFFSET()        -> x { x <- add(1,                  HASHER__CV_STACK_LEN__OFFSET()) }

def HASHER__SIZE() -> x { x <- add(HASHER__FLAGS__OFFSET(), 4) }

def Hasher__chunk_state__ptr(self) -> ptr { ptr <- self }
def Hasher__key_words__ptr(self) -> ptr { ptr <- add(self, HASHER__KEY_WORDS__OFFSET()) }
def Hasher__cv_stack__ptr(self) -> ptr { ptr <- add(self, HASHER__CV_STACK__OFFSET()) }

def Hasher__cv_stack_len__get(self) -> cv_stack_len { cv_stack_len <- read1(add(self, HASHER__CV_STACK_LEN__OFFSET())) }
def Hasher__flags__get(self) -> flags { flags <- read4(add(self, HASHER__FLAGS__OFFSET())) }

def Hasher__cv_stack_len__set(self, cv_stack_len) { write1(add(self, HASHER__CV_STACK_LEN__OFFSET()), cv_stack_len) }
def Output__flags__set(self, flags)               { write4(add(self, OUTPUT__FLAGS__OFFSET()),        flags)        }


def first_8_words(
  compression_output, # [u32; 16]
) -> ptr {
    # effectively a noop since this is just a sizing conversion from 16 words to 8
    # compression_output[0..8].try_into().unwrap()
    ptr <- compression_output
}


def parent_output(
  left_child_cv,  # [u32; 8]
  right_child_cv, # [u32; 8]
  key_words,      # [u32; 8]
  flags,          # u32
  out,            # Output
) {
  copyWords(key_words, Output__input_chaining_value__ptr(out), 8)
  # block_words[..8].copy_from_slice(&left_child_cv)
  copyWords(left_child_cv, Output__block_words__ptr(out), 8)
  # block_words[8..].copy_from_slice(&right_child_cv)
  copyWords(right_child_cv, add(Output__block_words__ptr(out), mul(4, 8)), 8)
  Output__counter__set(out, 0) # Always 0 for parent nodes.
  Output__block_len__set(out, BLOCK_LEN()) # Always BLOCK_LEN (64) for parent nodes.
  Output__flags__set(out, or(PARENT(), flags))
}

def parent_cv(
  left_child_cv,  # [u32; 8]
  right_child_cv, # [u32; 8]
  key_words,      # [u32; 8]
  flags,          # u32
  out,            # [u32; 8] 
) {
  parent_output(left_child_cv, right_child_cv, key_words, flags, out)

  Output__chaining_value(out, 0) # TODO: Figure out what this should point to
}



def Hasher__push_stack(
  self,
  cv, # [u32; 8]
) {

  # self.cv_stack[self.cv_stack_len as usize] = cv;
  copyWords(cv, add(Hasher__cv_stack__ptr(self), mul(Hasher__cv_stack_len__get(self), mul(4, 8))), 8)
  # self.cv_stack_len += 1;
  Hasher__cv_stack_len__set(self, add(Hasher__cv_stack_len__get(self), 1))
}

def Hasher__pop_stack(self) -> ptr # [u32; 8]
{
  # self.cv_stack_len -= 1;
  Hasher__cv_stack_len__set(self, sub(Hasher__cv_stack_len__get(self), 1))
  # self.cv_stack[self.cv_stack_len as usize]
  ptr <- Hasher__cv_stack_len__get(self)
}




def Hasher__add_chunk_chaining_value(
  self,
  new_cv,       # [u32; 8]
  total_chunks, # u64
) {
  # This chunk might complete some subtrees. For each completed subtree,
  # its left child will be the current top entry in the CV stack, and
  # its right child will be the current value of `new_cv`. Pop each left
  # child off the stack, merge it with `new_cv`, and overwrite `new_cv`
  # with the result. After all these merges, push the final value of
  # `new_cv` onto the stack. The number of completed subtrees is given
  # by the number of trailing 0-bits in the new total number of chunks.
  loop :a {
    if eq(and(total_chunks, 1), 0) {
      new_cv <- 0
      parent_cv(Hasher__pop_stack(self), new_cv, Hasher__key_words__ptr(self), Hasher__flags__get(self), new_cv)
      total_chunks <- shr(total_chunks, 1)
    } else {
      break :a
    }
  }

  Hasher__push_stack(self, new_cv)
}



def Hasher__update(self) {
  len <- 0
  loop :input {
    if eq(len, dlen()) {
      break :input
    }

    chunk_state_ptr <- Hasher__chunk_state__ptr(self)

    # If the current chunk is complete, finalize it and reset the
    # chunk state. More input is coming, so this chunk is not ROOT.
    if eq(ChunkState__len(chunk_state_ptr), CHUNK_LEN()) {
      chunk_cv <- 0 # TODO: Make this a pointer to something
      Output__chaining_value(ChunkState__output(Hasher__chunk_state__ptr(self)), chunk_cv)
      total_chunks <- add(ChunkState__chunk_counter__get(chunk_state_ptr), 1)
      Hasher__add_chunk_chaining_value(self, chunk_cv, total_chunks)

      copyWords(ChunkState__chaining_value__ptr(chunk_state_ptr), Hasher__key_words__ptr(self), 8)
      zeroWords(ChunkState__block__ptr(chunk_state_ptr), BLOCK_LEN())

      ChunkState__chunk_counter__set(chunk_state_ptr, total_chunks)
      ChunkState__block_len__set(chunk_state_ptr, 0)
      ChunkState__blocks_compressed__set(chunk_state_ptr, 0)
      ChunkState__flags__set(chunk_state_ptr, Hasher__flags__get(self))
    }

    # Compress input bytes into the current chunk state.
    want <- sub(CHUNK_LEN(), ChunkState__len(chunk_state_ptr))
    take <- min(want, dlen())
    ChunkState__update(chunk_state_ptr, len, take) # &input[..take]
    # input <- &input[take..]
    len <- add(len, take)
  }
}

# init hasher

alloc(HASHER__SIZE())

hasher_ptr <- 0

IV <- HASHER__SIZE()

alloc(mul(4, 8))
writeWord(IV, 0, 0x6A09E667)
writeWord(IV, 1, 0xBB67AE85)
writeWord(IV, 2, 0x3C6EF372)
writeWord(IV, 3, 0xA54FF53A)
writeWord(IV, 4, 0x510E527F)
writeWord(IV, 5, 0x9B05688C)
writeWord(IV, 6, 0x1F83D9AB)
writeWord(IV, 7, 0x5BE0CD19)

# Hasher::new
copyWords(IV, Hasher__key_words__ptr(hasher_ptr), 8)
copyWords(IV, ChunkState__chaining_value__ptr(Hasher__chunk_state__ptr(hasher_ptr)), 8)

Hasher__update(hasher_ptr)

