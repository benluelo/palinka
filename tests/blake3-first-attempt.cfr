#     flags: u32,
# }

def CHUNK_STATE__CHUNK_COUNTER__OFFSET()     -> x { x <- mul(4, 8)                                                          }
def CHUNK_STATE__BLOCK__OFFSET()             -> x { x <- add(8,                   CHUNK_STATE__CHUNK_COUNTER__OFFSET())     }
def CHUNK_STATE__BLOCK_LEN__OFFSET()         -> x { x <- add(mul(1, BLOCK_LEN()), CHUNK_STATE__BLOCK__OFFSET())             }
def CHUNK_STATE__BLOCKS_COMPRESSED__OFFSET() -> x { x <- add(1,                   CHUNK_STATE__BLOCK_LEN__OFFSET())         }
def CHUNK_STATE__FLAGS__OFFSET()             -> x { x <- add(1,                   CHUNK_STATE__BLOCKS_COMPRESSED__OFFSET()) }

def CHUNK_STATE__SIZE() -> x { x <- add(4, CHUNK_STATE__FLAGS__OFFSET()) }

# accessors

def ChunkState__chaining_value__ptr(self) -> arr_ptr { arr_ptr <- self }
def ChunkState__block__ptr(self) -> arr_ptr { arr_ptr <- add(self, CHUNK_STATE__BLOCK__OFFSET()) }

def ChunkState__chunk_counter__get(self) -> chunk_counter         { chunk_counter     <- read8(add(self, CHUNK_STATE__CHUNK_COUNTER__OFFSET()))     }
def ChunkState__block_len__get(self) -> block_len                 { block_len         <- read4(add(self, CHUNK_STATE__BLOCK_LEN__OFFSET()))         }
def ChunkState__blocks_compressed__get(self) -> blocks_compressed { blocks_compressed <- read4(add(self, CHUNK_STATE__BLOCKS_COMPRESSED__OFFSET())) }
def ChunkState__flags__get(self) -> flags                         { flags             <- read4(add(self, CHUNK_STATE__FLAGS__OFFSET()))             }

def ChunkState__chunk_counter__set(self, chunk_counter)          { write8(add(self, CHUNK_STATE__CHUNK_COUNTER__OFFSET()),     chunk_counter)     }
def ChunkState__block_len__set(self, block_len)                  { write4(add(self, CHUNK_STATE__BLOCK_LEN__OFFSET()),         block_len)         }
def ChunkState__blocks_compressed__set(self, blocks_compressed)  { write4(add(self, CHUNK_STATE__BLOCKS_COMPRESSED__OFFSET()), blocks_compressed) }
def ChunkState__flags__set(self, flags)                          { write4(add(self, CHUNK_STATE__FLAGS__OFFSET()),             flags)             }

# methods

def ChunkState__len(self) -> len {
  len <- add(mul(BLOCK_LEN(), ChunkState__blocks_compressed__get(self)), ChunkState__block_len__get(self))
}

