##########
# CONSTS #
##########

def OUT_LEN() -> x { x <- 32 }     # usize
def KEY_LEN() -> x { x <- 32 }     # usize
def BLOCK_LEN() -> x { x <- 64 }   # usize
def CHUNK_LEN() -> x { x <- 1024 } # usize

def CHUNK_START() -> x { x <- shl(1, 0) }         # u32
def CHUNK_END() -> x { x <- shl(1, 1) }           # u32
def PARENT() -> x { x <- shl(1, 2) }              # u32
def ROOT() -> x { x <- shl(1, 3) }                # u32
def KEYED_HASH() -> x { x <- shl(1, 4) }          # u32
def DERIVE_KEY_CONTEXT() -> x { x <- shl(1, 5) }  # u32
def DERIVE_KEY_MATERIAL() -> x { x <- shl(1, 6) } # u32

#########
# UTILS #
#########

def min(a, b) -> c {
  if lt(a, b) {
    c <- a
  } else {
    c <- b
  }
}

def copyWords(from, to, len) {
  i <- 0
  loop :copy {
    if eq(i, len) {
      break :copy
    }

    write4(add(to, mul(i, 4)), read4(add(from, mul(i, 4))))

    i <- add(i, 1)
  }
}

def zeroWords(words, len) {
  i <- 0
  loop :copy {
    if eq(i, len) {
      break :copy
    }

    write4(add(words, mul(i, 4)), 0)

    i <- add(i, 1)
  }
}


def readState(at) -> value {
  value <- read4(mul(at, 4))
}

def writeState(at, value) {
  write4(mul(at, 4), value)
}

def readWord(base, at) -> value {
  value <- read4(add(base, mul(at, 4)))
}

def writeWord(base, at, value) {
  write4(add(base, mul(at, 4)), value)
}

def wrappingAdd(a, b) -> c {
  c <- mod(add(a, b), exp(2, 32))
}

def rotateRight(a, offset) -> n {
  n <- xor(shr(a, offset), shl(a, sub(32, offset)))
}


# The mixing function, G, which mixes either a column or a diagonal.
def g(state, a, b, c, d, mx, my) {
  writeWord(state, a, wrappingAdd(readWord(state, a), wrappingAdd(readWord(state, b), mx)))
  writeWord(state, d, rotateRight(xor(readWord(state, d), readWord(state, a)), 16))
  writeWord(state, a, wrappingAdd(readWord(state, c), readWord(state, d)))
  writeWord(state, b, rotateRight(xor(readWord(state, b), readWord(state, c)), 12))
  writeWord(state, a, wrappingAdd(readWord(state, a), wrappingAdd(readWord(state, b), my)))
  writeWord(state, d, rotateRight(xor(readWord(state, d), readWord(state, a)), 8))
  writeWord(state, a, wrappingAdd(readWord(state, c), readWord(state, d)))
  writeWord(state, b, rotateRight(xor(readWord(state, b), readWord(state, c)), 7))
}

    # let mut permuted <- [0 16]
    # for i in 0..16 {
    #     permuted[i] <- m[MSG_PERMUTATION[i]]
    # }
    # *m <- permuted
def permute(m) {
  MSG_PERMUTATION <- mul(4, 16)
  scratch <- mul(2, mul(4, 16))

  i <- 0
  loop :a {
    if eq(i, 16) {
      break :a
    }

    writeWord(scratch, i, readWord(m, readWord(MSG_PERMUTATION, i)))

    i <- add(i, 1)
  }
}

def round(state, m) {
  # Mix the columns.
  g(state, 0, 4, 8, 12, readWord(m, 0), readWord(m, 1))
  g(state, 1, 5, 9, 13, readWord(m, 2), readWord(m, 3))
  g(state, 2, 6, 10, 14, readWord(m, 4), readWord(m, 5))
  g(state, 3, 7, 11, 15, readWord(m, 6), readWord(m, 7))
  # Mix the diagonals.
  g(state, 0, 5, 10, 15, readWord(m, 8), readWord(m, 9))
  g(state, 1, 6, 11, 12, readWord(m, 10), readWord(m, 11))
  g(state, 2, 7, 8, 13, readWord(m, 12), readWord(m, 13))
  g(state, 3, 4, 9, 14, readWord(m, 14), readWord(m, 15))
}

def compress(
    chaining_value, # &[u32; 8]
    block_words,    # &[u32; 16]
    counter,        # u64
    block_len,      # u32
    flags,          # u32
    out             # &mut [u32; 16]
) {
  IV_0 <- 0x6A09E667
  IV_1 <- 0xBB67AE85
  IV_2 <- 0x3C6EF372
  IV_3 <- 0xA54FF53A
  IV_4 <- 0x510E527F
  IV_5 <- 0x9B05688C
  IV_6 <- 0x1F83D9AB
  IV_7 <- 0x5BE0CD19

  counter_low <- counter
  counter_high <- shr(counter, 32)
  writeWord(out, 0, readWord(chaining_value, 0))
  writeWord(out, 1, readWord(chaining_value, 1))
  writeWord(out, 2, readWord(chaining_value, 2))
  writeWord(out, 3, readWord(chaining_value, 3))
  writeWord(out, 4, readWord(chaining_value, 4))
  writeWord(out, 5, readWord(chaining_value, 5))
  writeWord(out, 6, readWord(chaining_value, 6))
  writeWord(out, 7, readWord(chaining_value, 7))
  writeWord(out, 8, IV_0)
  writeWord(out, 9, IV_1)
  writeWord(out, 10, IV_2)
  writeWord(out, 11, IV_3)
  writeWord(out, 12, counter_low)
  writeWord(out, 13, counter_high)
  writeWord(out, 14, block_len)
  writeWord(out, 15, flags)

  block <- block_words

  round(out, block) # round 1
  permute(block)
  round(out, block) # round 2
  permute(block)
  round(out, block) # round 3
  permute(block)
  round(out, block) # round 4
  permute(block)
  round(out, block) # round 5
  permute(block)
  round(out, block) # round 6
  permute(block)
  round(out, block) # round 7

  i <- 0
  loop :a {
    if eq(i, 8) {
      break :a
    }

    state_i <- readWord(out, i)
    state_i_plus_8 <- readWord(out, add(i, 8))
    # state[i] ^= state[i + 8]
    writeWord(
      out, i,
      xor(state_i, state_i_plus_8)
    )
    # state[i + 8] ^= chaining_value[i]
    writeWord(
      out, add(i, 8),
      xor(state_i_plus_8, readWord(chaining_value, add(i, 8)))
    )

    i <- add(i, 1)
  }
}

##########
# Output #
##########

# Each chunk or parent node can produce either an 8-word chaining value or, by
# setting the ROOT flag, any number of final output bytes. The Output struct
# captures the state just prior to choosing between those two possibilities.
#
# struct Output {
#     input_chaining_value: [u32; 8],
#     block_words: [u32; 16],
#     counter: u64,
#     block_len: u32,
#     flags: u32,
# }

def OUTPUT__BLOCK_WORDS__OFFSET() -> x { x <- mul(4, 8)                                     }
def OUTPUT__COUNTER__OFFSET()     -> x { x <- add(mul(4, 8), OUTPUT__BLOCK_WORDS__OFFSET()) }
def OUTPUT__BLOCK_LEN__OFFSET()   -> x { x <- add(8,         OUTPUT__COUNTER__OFFSET())     }
def OUTPUT__FLAGS__OFFSET()       -> x { x <- add(4,         OUTPUT__BLOCK_LEN__OFFSET())   }

def OUTPUT__SIZE() -> x { x <- add(OUTPUT__FLAGS__OFFSET(), 4) }

# accessors

def Output__input_chaining_value__ptr(self) -> arr_ptr { arr_ptr <- self }
def Output__block_words__ptr(self)          -> arr_ptr { arr_ptr <- add(self, OUTPUT__BLOCK_WORDS__OFFSET()) }

def Output__counter__get(self) -> counter     { counter   <- read8(add(self, OUTPUT__COUNTER__OFFSET()))   }
def Output__block_len__get(self) -> block_len { block_len <- read4(add(self, OUTPUT__BLOCK_LEN__OFFSET())) }
def Output__flags__get(self) -> flags         { flags     <- read4(add(self, OUTPUT__FLAGS__OFFSET()))     }

def Output__counter__set(self, counter)     { write8(add(self, OUTPUT__COUNTER__OFFSET()),   counter)   }
def Output__block_len__set(self, block_len) { write4(add(self, OUTPUT__BLOCK_LEN__OFFSET()), block_len) }
def Output__flags__set(self, flags)         { write4(add(self, OUTPUT__FLAGS__OFFSET()),     flags)     }

# methods

def Output__chaining_value(
  self, # Output
  out,  # [u32; 8]
) {
  # first_8_words(compress(
  #   &self.input_chaining_value,
  #   &self.block_words,
  #   self.counter,
  #   self.block_len,
  #   self.flags,
  # ))
  1
}

def Output__root_output_bytes(self, out_len, out_slice) {
  output_block_counter <- 0

  out_block <- 0
  loop :a {
    if gt(out_block, mul(2, OUT_LEN())) {
      break :a
    }

    # TODO: Make this actually point to useable memory
    words <- 0

    compress(
      Output__input_chaining_value__ptr(self),
      Output__block_words__ptr(self),
      output_block_counter,
      Output__block_len__get(self),
      or(Output__flags__get(self), ROOT()),
      words
    )
    # The output length might not be a multiple of 4.
    # TODO: Handle this correctly
    i <- 0
    loop :copy {
      writeWord(out_block, i, readWord(words, i))
      # for (word, out_word) in words.iter().zip(out_block.chunks_mut(4)) {
      #   out_word.copy_from_slice(word.to_le_bytes()[..out_word.len()])
      # }
      # FIXME: This is broken I'm pretty sure
      if gt(i, div(out_block, 4)) {
        break :copy
      }
    }
    output_block_counter <- add(output_block_counter, 1)
    out_block <- add(out_block, mul(2, OUT_LEN()))
  }
}

