def BLOCK_LEN() -> x { x <- 64 }   # usize
def CHUNK_LEN() -> x { x <- 1024 } # usize

def CHUNK_START() -> x { x <- shl(1, 0) }         # u32
def CHUNK_END() -> x { x <- shl(1, 1) }           # u32
def PARENT() -> x { x <- shl(1, 2) }              # u32
def ROOT() -> x { x <- shl(1, 3) }                # u32

def min(a, b) -> c {
  if lt(a, b) {
    c <- a
  } else {
    c <- b
  }
}

def swap_endianness(in) -> out {
  a <- or(shr(and(in, 0xFF000000), 24), shr(and(in, 0x00FF0000),  8))
  b <- or(shl(and(in, 0x0000FF00),  8), shl(and(in, 0x000000FF), 24))
  out <- or(a, b)
}

def copy_bytes(src, dst, len) {
  # dst[0..len].copy_from_slice(&src[0..len]);
  i <- 0
  loop :a {
    if eq(i, len) {
      break :a
    }
    write1(add(dst, i), read1(add(src, i)))
    i <- add(i, 1)
  }
}

def readWord(base, at) -> value {
  value <- swap_endianness(read4(add(base, mul(at, 4))))
}

def readWordBE(base, at) -> value {
  value <- read4(add(base, mul(at, 4)))
}

def writeWord(base, at, value) {
  write4(add(base, mul(at, 4)), swap_endianness(value))
}

def writeWordBE(base, at, value) {
  write4(add(base, mul(at, 4)), value)
}

def copy_words_8(from, to) {
  i <- 0
  loop :copy {
    if eq(i, 32) {
      break :copy
    }

    write8(add(to, i), read8(add(from, i)))

    i <- add(i, 8)
  }
}

def copy_words_from_input(from, to) {
  i <- 0
  loop :copy {
    if eq(i, 64) {
      break :copy
    }

    write8(add(to, i), read8(add(from, i)))

    i <- add(i, 8)
  }
}

def wrappingAdd(a, b) -> c {
  c <- mod(add(a, b), exp(2, 32))
}

def rotateRight(a, offset) -> n {
  n <- and(xor(shr(a, offset), shl(a, sub(32, offset))), 0x00000000FFFFFFFF)
}

def zero_words_16(words) {
  i <- 0
  loop :copy {
    if eq(i, 64) {
      break :copy
    }

    write8(add(words, i), 0)

    i <- add(i, 8)
  }
}



def MSG_SCHEDULE(i) -> n {
  n <- read1(i)
}

# The mixing function, G, which mixes either a column or a diagonal.
def g(round, n, state, a, b, c, d, mx, my) {
  writeWord(state, a, wrappingAdd(wrappingAdd(readWord(state, a),             readWord(state, b)), mx))
  writeWord(state, d, rotateRight(swap_endianness(xor(readWordBE(state, d), readWordBE(state, a))), 16))
  writeWord(state, c, wrappingAdd(    readWord(state, c),                     readWord(state, d)))
  writeWord(state, b, rotateRight(swap_endianness(xor(readWordBE(state, b), readWordBE(state, c))), 12))
  writeWord(state, a, wrappingAdd(wrappingAdd(readWord(state, a),             readWord(state, b)), my))
# if and(eq(round, 1), eq(n, 2)) { exit(state, 64) }
  writeWord(state, d, rotateRight(swap_endianness(xor(readWordBE(state, d), readWordBE(state, a))), 8))
  writeWord(state, c, wrappingAdd(    readWord(state, c),                     readWord(state, d)))
  writeWord(state, b, rotateRight(swap_endianness(xor(readWordBE(state, b), readWordBE(state, c))), 7))
}

def round(state, msg, round) {
    # Select the message schedule based on the round.

    # Mix the columns.
    g(round, 0, state, 0, 4, 8, 12,  readWord(msg, MSG_SCHEDULE(add(mul(round, 16), 0))),  readWord(msg, MSG_SCHEDULE(add(mul(round, 16), 1))))
    g(round, 1, state, 1, 5, 9, 13,  readWord(msg, MSG_SCHEDULE(add(mul(round, 16), 2))),  readWord(msg, MSG_SCHEDULE(add(mul(round, 16), 3))))
    g(round, 2, state, 2, 6, 10, 14, readWord(msg, MSG_SCHEDULE(add(mul(round, 16), 4))),  readWord(msg, MSG_SCHEDULE(add(mul(round, 16), 5))))
    g(round, 3, state, 3, 7, 11, 15, readWord(msg, MSG_SCHEDULE(add(mul(round, 16), 6))),  readWord(msg, MSG_SCHEDULE(add(mul(round, 16), 7))))

    # Mix the diagonals.
    g(round, 4, state, 0, 5, 10, 15, readWord(msg, MSG_SCHEDULE(add(mul(round, 16), 8))),  readWord(msg, MSG_SCHEDULE(add(mul(round, 16), 9))))
    g(round, 5, state, 1, 6, 11, 12, readWord(msg, MSG_SCHEDULE(add(mul(round, 16), 10))), readWord(msg, MSG_SCHEDULE(add(mul(round, 16), 11))))
    g(round, 6, state, 2, 7, 8, 13,  readWord(msg, MSG_SCHEDULE(add(mul(round, 16), 12))), readWord(msg, MSG_SCHEDULE(add(mul(round, 16), 13))))
    g(round, 16, state, 3, 4, 9, 14,  readWord(msg, MSG_SCHEDULE(add(mul(round, 16), 14))), readWord(msg, MSG_SCHEDULE(add(mul(round, 16), 15))))
}

def compress(
    state,
    chaining_value,
    block_words,
    counter,
    block_len,
    flags,
) {
    IV_0 <- 0x6A09E667
    IV_1 <- 0xBB67AE85
    IV_2 <- 0x3C6EF372
    IV_3 <- 0xA54FF53A
    IV_4 <- 0x510E527F
    IV_5 <- 0x9B05688C
    IV_6 <- 0x1F83D9AB
    IV_7 <- 0x5BE0CD19

    counter_low <- and(counter, 0x00000000FFFFFFFF)
    counter_high <- shr(counter, 32)

    writeWordBE(state, 0, readWordBE(chaining_value, 0))
    writeWordBE(state, 1, readWordBE(chaining_value, 1))
    writeWordBE(state, 2, readWordBE(chaining_value, 2))
    writeWordBE(state, 3, readWordBE(chaining_value, 3))
    writeWordBE(state, 4, readWordBE(chaining_value, 4))
    writeWordBE(state, 5, readWordBE(chaining_value, 5))
    writeWordBE(state, 6, readWordBE(chaining_value, 6))
    writeWordBE(state, 7, readWordBE(chaining_value, 7))
    writeWord(state, 8, IV_0)
    writeWord(state, 9, IV_1)
    writeWord(state, 10, IV_2)
    writeWord(state, 11, IV_3)
    writeWord(state, 12, counter_low)
    writeWord(state, 13, counter_high)
    writeWord(state, 14, block_len)
    writeWord(state, 15, flags)


    # exit(block_words, 64)
    round(state, block_words, 0)
    round(state, block_words, 1)
    round(state, block_words, 2)
    round(state, block_words, 3)
    round(state, block_words, 4)
    round(state, block_words, 5)
    round(state, block_words, 6)


    i <- 0
    loop :a {
      if eq(i, 8) {
        break :a
      }

      # state[i] ^= state[i + 8]
      writeWordBE(
        state, i,
        xor(readWordBE(state, i), readWordBE(state, add(i, 8)))
      )
      # state[i + 8] ^= chaining_value[i]
      writeWordBE(
        state, add(i, 8),
        xor(readWordBE(state, add(i, 8)), readWordBE(chaining_value, i))
      )

      i <- add(i, 1)
    }
}

# STATE:

msg_schedule_state <- 0
msg_schedule_state_SIZE <- mul(16, 7)
alloc(msg_schedule_state_SIZE)

write8(add(msg_schedule_state, mul(8, 0)), 0x0001020304050607)
write8(add(msg_schedule_state, mul(8, 1)), 0x08090a0b0c0d0e0f)
write8(add(msg_schedule_state, mul(8, 2)), 0x0206030a0700040d)
write8(add(msg_schedule_state, mul(8, 3)), 0x010b0c05090e0f08)
write8(add(msg_schedule_state, mul(8, 4)), 0x03040a0c0d02070e)
write8(add(msg_schedule_state, mul(8, 5)), 0x060509000b0f0801)
write8(add(msg_schedule_state, mul(8, 6)), 0x0a070c090e030d0f)
write8(add(msg_schedule_state, mul(8, 7)), 0x04000b0205080106)
write8(add(msg_schedule_state, mul(8, 8)), 0x0c0d090b0f0a0e08)
write8(add(msg_schedule_state, mul(8, 9)), 0x0702050300010604)
write8(add(msg_schedule_state, mul(8, 10)), 0x090e0b05080c0f01)
write8(add(msg_schedule_state, mul(8, 11)), 0x0d03000a02060407)
write8(add(msg_schedule_state, mul(8, 12)), 0x0b0f050001090806)
write8(add(msg_schedule_state, mul(8, 13)), 0x0e0a020c0304070d)


chunk_state_block_buffer_SIZE <- BLOCK_LEN()
alloc(chunk_state_block_buffer_SIZE)
chunk_state_block_buffer <- add(msg_schedule_state, msg_schedule_state_SIZE)

# 16-word scratch state
words_16_SIZE <- mul(4, 16)
alloc(words_16_SIZE)
words_16 <- add(chunk_state_block_buffer_SIZE, chunk_state_block_buffer)

# 8-word scratch state
words_8_SIZE <- mul(4, 8)
alloc(words_8_SIZE)
words_8 <- add(words_16_SIZE, words_16)

IV_SIZE <- mul(4, 8)
alloc(IV_SIZE)
IV <- add(words_8_SIZE, words_8)

writeWord(IV, 0, 0x6A09E667)
writeWord(IV, 1, 0xBB67AE85)
writeWord(IV, 2, 0x3C6EF372)
writeWord(IV, 3, 0xA54FF53A)
writeWord(IV, 4, 0x510E527F)
writeWord(IV, 5, 0x9B05688C)
writeWord(IV, 6, 0x1F83D9AB)
writeWord(IV, 7, 0x5BE0CD19)

# output buffer
out_len <- 32
alloc(out_len)
out <- add(IV, IV_SIZE)

chaining_value_SIZE <- mul(4, 8)
alloc(chaining_value_SIZE)
chaining_value <- add(out, out_len)

copy_words_8(IV, chaining_value)

# scratch state for compress
compress_state_SIZE <- mul(4, 16)
alloc(compress_state_SIZE)
compress_state <- add(chaining_value, chaining_value_SIZE)

# chaining values
cv_stack_SIZE <- mul(mul(4, 8), 54)
alloc(cv_stack_SIZE)
cv_stack <- add(compress_state_SIZE, compress_state)

chunk_counter <- 0
chunk_state_block_len <- 0
blocks_compressed <- 0

cv_stack_len <- 0

chunk_idx <- 0
chunk_input_ptr <- 0
chunk_input_len <- 0
loop :a {
    val <- mul(chunk_idx, CHUNK_LEN())
    if or(gt(val, dlen()), eq(val, dlen())) {
        break :a
    }
    chunk_input_ptr <- min(dlen(), mul(CHUNK_LEN(), chunk_idx))
    chunk_input_len <- min(sub(dlen(), chunk_input_ptr), CHUNK_LEN())
    chunk_idx <- add(chunk_idx, 1)

    # If the current chunk is complete, finalize it and reset the
    # chunk state. More input is coming, so this chunk is not ROOT.
    if eq(add(mul(BLOCK_LEN(), blocks_compressed), chunk_state_block_len), CHUNK_LEN()) {
        # trap(1)
        copy_words_from_input(chunk_state_block_buffer, words_16)

        total_chunks <- add(chunk_counter, 1)


        flags <- 0
        # trap(eq(blocks_compressed, 0))
        if eq(blocks_compressed, 0) {
            flags <- CHUNK_START()
        }
        # trap(flags)
        # trap(blocks_compressed)
        # exit(compress_state, 64)
        # trap(or(flags, CHUNK_END()))
        compress(
            compress_state,
            chaining_value,
            words_16,
            chunk_counter,
            chunk_state_block_len,
            or(flags, CHUNK_END())
        )
        # exit(compress_state, 64)
        copy_words_8(compress_state, words_8)
        # exit(words_8, 32)

        total_chunks_ <- total_chunks
        loop :a {
            if not(eq(and(total_chunks_, 1), 0))  {
                break :a
            }

            cv_stack_len <- sub(cv_stack_len, 1)
            # REVIEW: I think this needs to be cv_stack_len * 32
            copy_words_8(add(cv_stack, mul(cv_stack_len, mul(4, 8))), words_16)
            copy_words_8(words_8, add(words_16, mul(4, 8)))
            compress(
                compress_state,
                IV,
                words_16,
                0,
                BLOCK_LEN(),
                PARENT()
            )
            copy_words_8(compress_state, words_8)
            total_chunks_ <- shr(total_chunks_, 1)
            # trap(2)
        }

        copy_words_8(words_8, add(cv_stack, mul(cv_stack_len, mul(4, 8))))
        # exit(words_8, 32)
        # trap(1)
        cv_stack_len <- add(cv_stack_len, 1)

        # chaining_value <- IV
        copy_words_8(IV, chaining_value)
        # exit(chaining_value, 32)
        chunk_counter <- total_chunks
        zero_words_16(chunk_state_block_buffer)
        chunk_state_block_len <- 0
        blocks_compressed <- 0
    }

    chunk_block_idx <- 0
    chunk_block_input_ptr <- 0
    chunk_block_input_len <- 0
    loop :a {
        val <- mul(chunk_block_idx, BLOCK_LEN())
        if or(gt(val, chunk_input_len), eq(val, chunk_input_len)) {
            break :a
        }
        # trap(1) # shouldn't reach here
        chunk_block_input_ptr <- min(chunk_input_len, mul(BLOCK_LEN(), chunk_block_idx))
        chunk_block_input_len <- min(sub(chunk_input_len, chunk_block_input_ptr), BLOCK_LEN())
        chunk_block_idx <- add(chunk_block_idx, 1)

        # chunk_block = input[chunk_input_ptr + chunk_block_input_ptr..]
        chunk_block <- add(chunk_input_ptr, chunk_block_input_ptr)

        if eq(chunk_state_block_len, BLOCK_LEN()) {
            copy_words_from_input(chunk_state_block_buffer, words_16)

            flags <- 0
            if eq(blocks_compressed, 0) {
                flags <- CHUNK_START()
            }
            compress(
                compress_state,
                chaining_value,
                words_16,
                chunk_counter,
                BLOCK_LEN(),
                flags
            )

            copy_words_8(compress_state, chaining_value)
            blocks_compressed <- add(blocks_compressed, 1)
            zero_words_16(chunk_state_block_buffer)
            chunk_state_block_len <- 0
        }

        dcopy(
            chunk_block,
            chunk_state_block_buffer,
            chunk_block_input_len
        )
        chunk_state_block_len <- add(chunk_state_block_len, chunk_block_input_len)

    }
}

output_flags <- CHUNK_END()
if eq(blocks_compressed, 0) {
    output_flags <- or(output_flags, CHUNK_START())
}

copy_words_from_input(chunk_state_block_buffer, words_16)
# exit(words_16, 64)

# trap(cv_stack_len)
# trap(output_flags)

loop :a {
  if eq(cv_stack_len, 0) {
    break :a
  }
  cv_stack_len <- sub(cv_stack_len, 1)
  # exit(chaining_value, 32)
  compress(
    compress_state,
    chaining_value,
    words_16,
    chunk_counter,
    chunk_state_block_len,
    output_flags
  )
  # exit(cv_stack, cv_stack_SIZE)
  copy_words_8(add(cv_stack, mul(cv_stack_len, mul(4, 8))), words_16)
  copy_words_8(compress_state, add(words_16, mul(8, 4)))

  # chaining_value <- IV
  copy_words_8(IV, chaining_value)
  chunk_counter <- 0
  chunk_state_block_len <- BLOCK_LEN()
  output_flags <- PARENT()
}

output_block_counter <- 0
out_block_ptr <- 0
loop :a {
    if or(gt(out_block_ptr, out_len), eq(out_block_ptr, out_len)) {
        break :a
    }

    # exit(words_16, 64)

    compress(
        compress_state,
        chaining_value,
        words_16,
        output_block_counter,
        chunk_state_block_len,
        or(output_flags, ROOT())
    )

    i <- 0
    loop :a {
        if eq(i, 16) {
            break :a
        }

        if or(gt(out_block_ptr, out_len), eq(out_block_ptr, out_len)) {
            break :a
        }

        out_word_len <- min(sub(out_len, out_block_ptr), 4)

        copy_bytes(
            # to_le_bytes(readWord(compress_state, i)),
            add(compress_state, mul(i, 4)),
            add(out, out_block_ptr),
            out_word_len
        )

        out_block_ptr <- add(out_block_ptr, 4)
        i <- add(i, 1)
    }

    output_block_counter <- add(output_block_counter, 1)
}

exit(out, out_len)
