{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "cefre",
      "camelcase": "Cefre",
      "title": "Cefre",
      "scope": "source.cfr",
      "file-types": [
        "cfr"
      ],
      "injection-regex": "^cfr$",
      "class-name": "TreeSitterCefre"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Cefre grammar for tree-sitter",
    "authors": [
      {
        "name": "ben"
      }
    ],
    "links": {
      "repository": "https://github.com/benluelo/palinka"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
